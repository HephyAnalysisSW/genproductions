import model SMEFTsim_general_MwScheme_UFO-SMEFT_massless_private_vec
define p = g u c d s b u~ c~ d~ s~ b~
define j = p

generate    p p > t~ w+ z    NPprop=0 SMHLOOP=0 NP=1 @0
add process p p > t  w- z    NPprop=0 SMHLOOP=0 NP=1 @0
add process p p > t~ w+ z j  NPprop=0 SMHLOOP=0 NP=1 @1
add process p p > t  w- z j  NPprop=0 SMHLOOP=0 NP=1 @1

output tWZ-vec
