#*********************************************************************
#                       MadGraph5_aMC@NLO                            *
#                                                                    *
#                     run_card.dat MadEvent                          *
#                                                                    *
#  This file is used to set the parameters of the run.               *
#                                                                    *
#  Some notation/conventions:                                        *
#                                                                    *
#   Lines starting with a '# ' are info or comments                  *
#                                                                    *
#   mind the format:   value    = variable     
#*********************************************************************
#
#*******************                                                 
# Running parameters
#*******************                                                 
#                                                                    
#*********************************************************************
# Tag name for the run (one word)                                    *
#*********************************************************************
                tag_1 = run_tag                
#*********************************************************************
# Number of events and rnd seed                                      *
# Warning: Do not generate more than 1M events in a single run       *
# If you want to run Pythia, avoid more than 50k events in a run.    *
#*********************************************************************
                 5000 = nevents                
                    0 = iseed                  
#*********************************************************************
# Collider type and energy                                           *
# lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
#                                         3=photon from electron     *
#*********************************************************************
                    1 = lpp1                   
                    1 = lpp2                   
               6500.0 = ebeam1                 
               6500.0 = ebeam2                 
#*********************************************************************
# Beam polarization from -100 (left-handed) to 100 (right-handed)    *
#*********************************************************************
                  0.0 = polbeam1               
                  0.0 = polbeam2               
#*********************************************************************
# PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
#*********************************************************************
               lhapdf = pdlabel                
# NNPDF30_lo_as_0130
#  263000 = lhaid     
# NNPDF31_nnlo_hessian_pdfas
# 306000 = lhaid     
    $DEFAULT_PDF_SETS = lhaid                  
 $DEFAULT_PDF_MEMBERS = reweight_PDF           

#*********************************************************************
# Renormalization and factorization scales                           *
#*********************************************************************
                False = fixed_ren_scale        
                False = fixed_fac_scale        
               91.188 = scale                  
               91.188 = dsqrt_q2fact1          
               91.188 = dsqrt_q2fact2          
                   -1 = dynamical_scale_choice 
                  1.0 = scalefact              
#*********************************************************************
# Type and output format
#*********************************************************************
                    T = gridpack               
                 -1.0 = time_of_flight         
                  3.0 = lhe_version            
                    T = clusinfo               
                  sum = event_norm             

#*********************************************************************
# Matching parameter (MLM only)
#*********************************************************************
                    0 = ickkw                  
                  1.0 = alpsfact               
                    F = chcluster              
                    5 = asrwgtflavor           
                    F = auto_ptj_mjj           
                                   
                    0 = xqcut                  
#*********************************************************************
#
#*********************************************************************
# handling of the helicities:
#  0: sum over all helicities
#  1: importance sampling over helicities
#*********************************************************************
                    0 = nhel                   
#*********************************************************************
# Generation bias, check the wiki page below for more information:   *
#  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
#*********************************************************************
                 None = bias_module            
                   {} = bias_parameters        
#
#*******************************                                                 
# Parton level cuts definition *
#*******************************                                     
#                                                                    
#
#*********************************************************************
# BW cutoff (M+/-bwcutoff*Gamma) 
#*********************************************************************
                 15.0 = bwcutoff               
#*********************************************************************
# Apply pt/E/eta/dr/mij/kt_durham cuts on decay products or not
# (note that etmiss/ptll/ptheavy/ht/sorted cuts always apply)
#*********************************************************************
                 True = cut_decays             
#*********************************************************************
# Standard Cuts                                                      *
#*********************************************************************
# Minimum and maximum pt's (for max, -1 means no cut)                *
#*********************************************************************
                  0.1 = ptj                    
                  0.0 = ptb                    
                  0.0 = pta                    
                  0.0 = ptl                    
                  0.0 = misset                 
                 -1.0 = ptjmax                 
                 -1.0 = ptbmax                 
                 -1.0 = ptamax                 
                 -1.0 = ptlmax                 
                 -1.0 = missetmax              
#*********************************************************************
# Minimum and maximum E's (in the center of mass frame)              *
#*********************************************************************
                  0.0 = ej                     
                  0.0 = eb                     
                  0.0 = ea                     
                  0.0 = el                     
                 -1.0 = ejmax                  
                 -1.0 = ebmax                  
                 -1.0 = eamax                  
                 -1.0 = elmax                  
#*********************************************************************
# Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
#*********************************************************************
                  5.0 = etaj                   
                 -1.0 = etab                   
                  2.5 = etaa                   
                  2.5 = etal                   
                  0.0 = etajmin                
                  0.0 = etabmin                
                  0.0 = etaamin                
                  0.0 = etalmin                
#*********************************************************************
# Minimum and maximum DeltaR distance                                *
#*********************************************************************
                  0.4 = drjj                   
                  0.0 = drbb                   
                  0.4 = drll                   
                  0.4 = draa                   
                  0.0 = drbj                   
                  0.4 = draj                   
                  0.4 = drjl                   
                  0.0 = drab                   
                  0.0 = drbl                   
                  0.4 = dral                   
                 -1.0 = drjjmax                
                 -1.0 = drbbmax                
                 -1.0 = drllmax                
                 -1.0 = draamax                
                 -1.0 = drbjmax                
                 -1.0 = drajmax                
                 -1.0 = drjlmax                
                 -1.0 = drabmax                
                 -1.0 = drblmax                
                 -1.0 = dralmax                
#*********************************************************************
# Minimum and maximum invariant mass for pairs                       *
# WARNING: for four lepton final state mmll cut require to have      *
#          different lepton masses for each flavor
#*********************************************************************
                  0.0 = mmjj                   
                  0.0 = mmbb                   
                  0.0 = mmaa                   
                  0.0 = mmll                   
                 -1.0 = mmjjmax                
                 -1.0 = mmbbmax                
                 -1.0 = mmaamax                
                 -1.0 = mmllmax                
#*********************************************************************
# Minimum and maximum invariant mass for all letpons                 *
#*********************************************************************
                  0.0 = mmnl                   
                 -1.0 = mmnlmax                
#*********************************************************************
# Minimum and maximum pt for 4-momenta sum of leptons                *
#*********************************************************************
                  0.0 = ptllmin                
                 -1.0 = ptllmax                
#*********************************************************************
# Inclusive cuts                                                     *
#*********************************************************************
                  0.0 = ptheavy                
                  0.0 = xptj                   
                  0.0 = xptb                   
                  0.0 = xpta                   
                  0.0 = xptl                   
#*********************************************************************
# Control the pt's of the jets sorted by pt                          *
#*********************************************************************
                  0.0 = ptj1min                
                  0.0 = ptj2min                
                  0.0 = ptj3min                
                  0.0 = ptj4min                
                 -1.0 = ptj1max                
                 -1.0 = ptj2max                
                 -1.0 = ptj3max                
                 -1.0 = ptj4max                
                    0 = cutuse                 
#*********************************************************************
# Control the pt's of leptons sorted by pt                           *
#*********************************************************************
                  0.0 = ptl1min                
                  0.0 = ptl2min                
                  0.0 = ptl3min                
                  0.0 = ptl4min                
                 -1.0 = ptl1max                
                 -1.0 = ptl2max                
                 -1.0 = ptl3max                
                 -1.0 = ptl4max                
#*********************************************************************
# Control the Ht(k)=Sum of k leading jets                            *
#*********************************************************************
                  0.0 = htjmin                 
                 -1.0 = htjmax                 
                  0.0 = ihtmin                 
                 -1.0 = ihtmax                 
                  0.0 = ht2min                 
                  0.0 = ht3min                 
                  0.0 = ht4min                 
                 -1.0 = ht2max                 
                 -1.0 = ht3max                 
                 -1.0 = ht4max                 
#***********************************************************************
# Photon-isolation cuts, according to hep-ph/9801442                   *
# When ptgmin=0, all the other parameters are ignored                  *
# When ptgmin>0, pta and draj are not going to be used                 *
#***********************************************************************
                  0.0 = ptgmin                 
                  0.4 = R0gamma                
                  1.0 = xn                     
                  1.0 = epsgamma               
                 True = isoEM                  
#*********************************************************************
# WBF cuts                                                           *
#*********************************************************************
                  0.0 = xetamin                
                  0.0 = deltaeta               
#***********************************************************************
# Turn on either the ktdurham or ptlund cut to activate                *
# CKKW(L) merging with Pythia8 [arXiv:1410.3012, arXiv:1109.4829]      *
#***********************************************************************
                 -1.0 = ktdurham               
                  0.4 = dparameter             
                 -1.0 = ptlund                 
 1, 2, 3, 4, 5, 6, 21 = pdgs_for_merging_cut   
#*********************************************************************
# maximal pdg code for quark to be considered as a light jet         *
# (otherwise b cuts are applied)                                     *
#*********************************************************************
                    5 = maxjetflavor           
#*********************************************************************
#
#*********************************************************************
# Store info for systematics studies                                 *
# WARNING: Do not use for interference type of computation           *
#*********************************************************************
                 False = use_syst               
#
#**************************************
# Parameter of the systematics study
#  will be used by SysCalc (if installed)
#**************************************                                  
#
              0.5 1 2 = sys_scalefact          
                 None = sys_alpsfact           
                 auto = sys_matchscale         
# PDF sets and number of members (0 or none for all members).
# MSTW2008nlo68cl.LHgrid 1  = sys_pdf
#
